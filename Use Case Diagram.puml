@startuml
left to right direction
actor "Pengunjung Website" as User

rectangle "Website Review Jurnal UI/UX" {
    usecase "Melihat Homepage & Highlight Jurnal" as UC1
    usecase "Navigasi Antar Halaman (Home <-> Review)" as UC2
    usecase "Melihat Daftar Fitur Utama" as UC3
    usecase "Mengisi & Mengirim Form Kontak/Masukan" as UC4
    usecase "Melihat Informasi Tim Penyusun (4 Anggota)" as UC5
    usecase "Membaca Review Jurnal Lengkap\n(About, Kekuatan, Kekurangan)" as UC6
}

User --> UC1
User --> UC2
User --> UC3
User --> UC4
User --> UC5
User --> UC6
@enduml