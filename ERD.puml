@startuml
' Hide circle icons for ERD standard
hide circle
skinparam linetype ortho

entity "KELOMPOK" as Kelompok {
    * id_kelompok : INT <<PK>>
    --
    nama_kelompok : VARCHAR
    kelas : VARCHAR
}

entity "ANGGOTA" as Anggota {
    * nim : VARCHAR <<PK>>
    --
    id_kelompok : INT <<FK>>
    nama_anggota : VARCHAR
}

entity "JURNAL_REVIEW" as Jurnal {
    * id_jurnal : INT <<PK>>
    --
    judul_jurnal : VARCHAR
    penulis : VARCHAR
    publikasi : VARCHAR
    ringkasan : TEXT
}

entity "FEEDBACK_FORM" as Feedback {
    * id_feedback : INT <<PK>>
    --
    nama_pengirim : VARCHAR
    email : VARCHAR
    subjek : VARCHAR
    pesan : TEXT
    created_at : TIMESTAMP
}

Kelompok ||--|{ Anggota : "memiliki"
Kelompok ||--o{ Jurnal : "menyusun review"
Jurnal ||--o{ Feedback : "menerima masukan"
@enduml