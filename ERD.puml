@startuml
hide circle
skinparam linetype ortho

entity "KELOMPOK" as Kelompok {
    * id_kelompok : INT <<PK>>
    --
    nama_kelompok : VARCHAR
    mata_kuliah : VARCHAR
}

entity "ANGGOTA_KELOMPOK" as Anggota {
    * nim : VARCHAR <<PK>>
    --
    id_kelompok : INT <<FK>>
    nama_anggota : VARCHAR
}

entity "JURNAL_REVIEW" as Jurnal {
    * id_jurnal : INT <<PK>>
    --
    judul_jurnal : VARCHAR
    penulis : VARCHAR
    publikasi : VARCHAR
    ringkasan : TEXT
}

entity "FEEDBACK_MASUKAN" as Feedback {
    * id_feedback : INT <<PK>>
    --
    nama_pengirim : VARCHAR
    email_pengirim : VARCHAR
    subjek : VARCHAR
    pesan : TEXT
}

Kelompok ||--|{ Anggota : "memiliki 4 anggota"
Kelompok ||--o{ Jurnal : "mereview"
Jurnal ||--o{ Feedback : "menerima masukan dari"
@enduml