@startuml
autonumber
actor "Pengunjung" as User
participant "index.html\n(Contact Form UI)" as UI
participant "Browser Validation Engine" as Engine
participant "onsubmit Event Handler" as Event

User -> UI : Mengisi Nama, Email, Subjek, & Pesan
User -> UI : Klik Tombol "Kirim Pesan"
UI -> Engine : Evaluasi Input (Attribute 'required' & 'type="email"')

alt Form Valid
    Engine -> Event : Jalankan event.preventDefault()
    Event --> User : Tampilkan Alert Popup ("Pesan Anda berhasil dikirim!")
    Event -> UI : Mencegah Reload Halaman (Error 405 Avoided)
else Form Tidak Valid
    Engine --> User : Tampilkan Pesan Peringatan Input Wajib Diisi
end
@enduml