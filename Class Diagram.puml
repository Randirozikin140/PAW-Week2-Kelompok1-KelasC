@startuml
class IndexHtml {
    +String title = "Homepage - Review Jurnal UI/UX"
    +renderNavbarFlexbox()
    +renderHeroGrid()
    +renderFeaturesGrid()
    +renderContactForm()
    +renderTeamGrid()
}

class LandingPageHtml {
    +String title = "Review Jurnal UI/UX"
    +renderHeader()
    +renderAboutSection()
    +renderKekuatanSection()
    +renderKekuranganSection()
    +renderTeamGrid()
}

class ContactForm {
    +String nama
    +String email
    +String subjek
    +String pesan
    +handleSubmit(event)
}

class TeamMember {
    +String nama
    +String nim
}

class StyleCss {
    +String flexboxLayout
    +String gridLayout
    +String formFocusState
    +String mediaQueryMobile
}

IndexHtml "1" *-- "1" ContactForm : memuat
IndexHtml "1" *-- "4" TeamMember : menampilkan
LandingPageHtml "1" *-- "4" TeamMember : menampilkan

IndexHtml ..> StyleCss : terhubung ke css/style.css
LandingPageHtml ..> StyleCss : terhubung ke css/style.css
@enduml